# ============================================
# Restaurant Social Media Automation - ENV
# ============================================
# Copy this to .env and fill in your keys

# --- Image Generation (ComfyUI) ---
COMFYUI_HOST=http://127.0.0.1
COMFYUI_PORT=8188

# --- Caption Generation (Priority: Groq > Gemini > Ollama) ---
# 1. Groq API (https://console.groq.com)
GROQ_API_KEY=

# 2. Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# 3. Ollama (local - no key needed, just running)
OLLAMA_HOST=http://127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2

# --- Facebook / Meta Graph API ---
# Get these from https://developers.facebook.com/
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_API_VERSION=v25.0

# --- App Settings ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
TEMP_DIR=./static/uploads
OUTPUT_DIR=./static/outputs
